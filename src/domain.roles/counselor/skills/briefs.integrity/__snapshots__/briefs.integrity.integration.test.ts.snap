// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`briefs.integrity given: [case1] --help flag when: [t0] help is requested then: the help text is snapshotted 1`] = `
"⚖️ briefs.integrity — check briefs against the mechanical invariants

usage:
  briefs.integrity.sh [--path <dir>] [--severity <level>] [--check <slug>] [--format <fmt>]

options:
  --path      directory to check         (default: src/domain.roles)
  --severity  all | blocker | nitpick    (default: all)
  --check     report only this check     (repeatable; default: all)
  --format    tree | json                (default: tree)

checks:
  see-also-target-absent               a .see also target that does not open
  sources-below-seven                  fewer than 7 numbered sources
  source-anchor-unreferenced           a source no body sentence uses
  not-advice-callout-absent            no 'not legal advice' callout
  date-researched-absent               no '## .date researched' section
  publishability-tag-absent            no triage tag
  non-fullsun-in-published-path        a withheld brief that would ship
  absence-claim-falsified-exact        claims text is absent while it holds it
  fullsun-names-non-fullsun            a public brief names a withheld one
  internal-scaffold-leaked-in-fullsun  a fullsun brief names a .behavior/ or .route/ path

examples:
  briefs.integrity.sh --path src/domain.roles/counselor --severity blocker
  briefs.integrity.sh --check non-fullsun-in-published-path --severity blocker
"
`;

exports[`briefs.integrity given: [case2] an unknown argument when: [t0] the skill is called with it then: the rejection stderr is snapshotted, so a caller sees it 1`] = `
"⚖️ blocked — unknown argument: --nonsuch
   fix: run with --help to see the accepted options
"
`;

exports[`briefs.integrity given: [case3] a path that does not exist when: [t0] the skill is called with it then: the bad-path stderr is snapshotted, counts masked 1`] = `
"⚖️ blocked — no directory at: src/does.not.exist
   fix: pass a directory that exists, e.g.
     briefs.integrity.sh --path src/domain.roles/counselor
"
`;

