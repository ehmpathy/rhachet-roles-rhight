// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`pdf.merge.sh given: [case1] a 1 page cover and a 2 page body when: [t0] they are merged in argument order then: the readout matches snapshot 1`] = `
"
🦅 bound together,

🔎 pdf.merge
   ├─ 1. <tmp>/cover.pdf: 1 page(s)
   ├─ 2. <tmp>/body.pdf: 2 page(s)
   ├─ pages: 3 of 3 expected ✅
   ├─ bytes: 2203
   └─ into: <tmp>/packet.pdf
